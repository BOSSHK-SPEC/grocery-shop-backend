PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=grocery_app
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
OTP_EXPIRY_MINUTES=5
# Set to 'true' only on local/dev machines to make OTP always '123456'. Never set in production.
ALLOW_TEST_OTP=false

# ── Auth / token rotation ────────────────────────────────────────────────
# Access tokens are short-lived; refresh tokens rotate. Set STRONG secrets.
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── MinIO / S3 image storage (optional) ──────────────────────────────────
# Leave blank to keep local-disk storage. Fill in to store images in MinIO.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=grocery-images
# Public base URL for objects (defaults to http://ENDPOINT:PORT/BUCKET)
MINIO_PUBLIC_URL=

# ── Razorpay payment gateway (optional) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
