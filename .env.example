PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=grocery_app
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
OTP_EXPIRY_MINUTES=5
# Set to 'true' ONLY on local/dev machines to make the login OTP always '123456'.
# Ignored whenever NODE_ENV=production; leave unset everywhere else too unless you
# really need it. A random OTP is issued in every other case.
ALLOW_DEV_OTP=false
# The fixed code used for ALL accounts while ALLOW_DEV_OTP is on (dev only).
DEV_OTP=200310
# TEMPORARY: also honour ALLOW_DEV_OTP when NODE_ENV=production. Only until
# an SMS provider is integrated — anyone knowing DEV_OTP can enter ANY
# account while this is on. Delete this line (and ALLOW_DEV_OTP) after SMS.
ALLOW_DEV_OTP_IN_PRODUCTION=false

# ── App-store review accounts ────────────────────────────────────────────
# Comma-separated phone numbers that always receive REVIEW_OTP as their
# login code (all environments, production included) — for Google Play /
# App Store reviewers, who cannot receive SMS. Pick numbers no real user
# owns and a code that is NOT 123456. Leave both empty to disable.
REVIEW_PHONES=
REVIEW_OTP=

# ── Auth rate limits (defaults shown; raise for internal testing) ────────
# Numbers in REVIEW_PHONES are always exempt from these limits.
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MIN=15
OTP_PHONE_MAX=5
OTP_PHONE_WINDOW_MIN=10

# ── Auth / token rotation ────────────────────────────────────────────────
# Access tokens are short-lived; refresh tokens rotate. Set STRONG secrets.
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Image storage (MinIO via `docker compose up -d`) — REQUIRED ─────────
# All images live in object storage; nothing is written to local disk. Local
# setup: fill in the four credentials below, then `docker compose up -d`
# starts MinIO and creates the buckets, access rules and app user.
#
# Root login: used ONLY by docker compose to bootstrap MinIO. The backend
# never reads it. Use long random values.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Restricted user the backend runs as: object read/write on the two buckets,
# nothing else. Created by the minio-init container. Must differ from root.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# How the backend reaches MinIO.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Product photos, store logos, profile pictures (anyone may open a known image).
MINIO_PUBLIC_BUCKET=grocery-public
# Driving licences and not-yet-confirmed uploads (signed links only).
MINIO_PRIVATE_BUCKET=grocery-private
# Address PHONES use to reach MinIO — an origin only, no path.
# Local dev: leave empty; the backend uses the host the app called it on
# (10.0.2.2 on the Android emulator, localhost elsewhere).
# Production: REQUIRED and https, e.g. https://images.example.com — the
# server refuses to start without it.
MINIO_PUBLIC_URL=
# Docker port binding: 127.0.0.1 keeps MinIO off your network (the Android
# emulator still reaches it); 0.0.0.0 to test from a real phone on your LAN.
MINIO_BIND_ADDRESS=127.0.0.1
# Browser origins allowed to upload directly (Flutter web). Narrow outside dev.
# MINIO_CORS_ALLOW_ORIGIN=*
# Server image override, e.g. an amd64-only hotfix build on a production host.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# Direct-upload link requests, per user (defaults shown).
UPLOAD_REQUEST_MAX=60
UPLOAD_REQUEST_WINDOW_MIN=10

# ── Razorpay payment gateway (optional) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Live order tracking ──────────────────────────────────────────────────
# OSRM-compatible routing server used for the rider/store/customer road routes.
# REQUIRED in production: the public demo server (used automatically outside
# production) forbids production traffic. Leave empty in production to get
# straight-line estimates only. Example: http://osrm.internal:5000
ROUTING_BASE_URL=

# ── Schema sync ──────────────────────────────────────────────────────────
# Default (unset/false): create missing tables only. Set to true ONCE after
# adding a column to an existing table, then unset it — alter mode adds a
# duplicate unique index per run and MySQL caps a table at 64.
DB_SYNC_ALTER=
